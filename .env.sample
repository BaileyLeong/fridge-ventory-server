# Server Configuration
PORT= # The port your server will run on (e.g., 3000)

# Database Configuration (Local)
DB_LOCAL_HOST= # The hostname for your local database (e.g., localhost)
DB_LOCAL_DBNAME= # The name of your local database
DB_LOCAL_USER= # Your local database username
DB_LOCAL_PASSWORD= # Your local database password

# CORS Configuration
CORS_ORIGIN= # Allowed origin(s) for CORS (e.g., http://localhost:3000 for local development)

# Spoonacular API (official: https://api.spoonacular.com - see https://spoonacular.com/food-api/docs)
SPOONACULAR_BASE_URL= # Base URL (e.g., https://api.spoonacular.com)
SPOONACULAR_API_KEY= # Your Spoonacular API key (get one at spoonacular.com)
